# ---------------------------------------------------------------------------
# Portfolio CMS configuration. Copy to .env for local work. In Vercel, add each
# variable under Project Settings > Environment Variables. Never commit .env.
# ---------------------------------------------------------------------------

# Canonical public origin of THIS deployment, no trailing slash. Used to build
# the Google sign-in return URL, which must also be listed in Supabase.
# Production: https://your-domain.com    Local: http://localhost:3000
APP_URL=http://localhost:3000

# Local development port (ignored on Vercel).
PORT=3000

# 32+ random characters. Seals the session cookie and derives CSRF tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=

# Comma-separated Google account emails allowed into /admin. Exact match,
# case-insensitive. Anyone else is refused server-side.
ADMIN_ALLOWED_EMAILS=you@example.com

# Absolute session lifetime in hours (1-72) and idle timeout in minutes (5-720).
SESSION_MAX_AGE_HOURS=12
SESSION_IDLE_MINUTES=60

# Admin sign-in is disabled on Vercel preview deployments unless this is true.
# Previews run unmerged code, so leave it false and give previews no secrets.
ALLOW_ADMIN_ON_PREVIEW=false

# Maximum image upload in MB (1-4). Vercel functions reject bodies over 4.5 MB.
MAX_UPLOAD_MB=4

# --- Supabase (Project Settings > API) --------------------------------------
# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=
# Public key (anon / publishable). Safe to expose but kept server-side here.
SUPABASE_ANON_KEY=
# SECRET key (service_role / secret). Server only. Never expose or commit.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket created by the migration.
SUPABASE_STORAGE_BUCKET=portfolio-images

# --- GitHub (Deployment Center) ---------------------------------------------
# Fine-grained personal access token limited to ONE repository with
# Contents: Read and write, Metadata: Read-only. Server only.
CMS_GITHUB_TOKEN=
CMS_GITHUB_OWNER=
CMS_GITHUB_REPO=
# Branch Vercel treats as production. The CMS never writes to it.
CMS_GITHUB_PRODUCTION_BRANCH=master

# --- Vercel (Deployment Center) ---------------------------------------------
# Token from vercel.com/account/tokens, scoped to your team. Server only.
CMS_VERCEL_TOKEN=
# Project ID (Project Settings > General).
CMS_VERCEL_PROJECT_ID=
# Team ID (team Settings > General). Leave empty for a personal account.
CMS_VERCEL_TEAM_ID=
# Public production URL used to verify a deployment, e.g. https://your-domain.com
CMS_PRODUCTION_URL=
# Require a finished preview of the exact commit before production (true/false).
CMS_REQUIRE_PREVIEW_BEFORE_PRODUCTION=true
