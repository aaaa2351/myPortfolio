{
  "name": "portfolio-cms",
  "version": "1.0.0",
  "description": "Portfolio CMS: public portfolio at / and a private Google-authenticated dashboard at /admin, backed by Supabase and deployed on Vercel",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "test:db": "node --test test/db/*.test.js",
    "db:seed": "node scripts/seed.js",
    "vercel:config": "node scripts/write-vercel-json.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "express": "^4.21.2",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "jsdom": "^31.0.0",
    "pg": "^8.23.1"
  }
}
